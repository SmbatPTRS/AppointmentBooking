# Copy to .env in this directory. Never commit .env.
# Development credentials only. Replace both copies of the example password.
# Use a password without semicolons for this simple connection-string example.
POSTGRES_DB=appointmentbooking
POSTGRES_USER=appointment_app
POSTGRES_PASSWORD=replace_this_local_password
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=appointmentbooking;Username=appointment_app;Password=replace_this_local_password"

# Shared Telegram foundation. Keep disabled until you configure credentials and a receiver.
Telegram__Enabled=false
Telegram__Mode=Polling
Telegram__PollingTimeoutSeconds=25
Telegram__PollingRetryDelaySeconds=1
Telegram__PollingMaxRetryDelaySeconds=30
# Optional username without @; required for commands addressed as /start@your_bot.
Telegram__BotUsername=
Telegram__BotToken=
Telegram__WebhookUrl=
Telegram__WebhookSecret=
Owner__TelegramUserId=0

# Optional per-user API access. Uncomment complete entries for registered users.
# Do not use blank entries: each enabled key requires a positive Telegram sender ID.
# ApiAccess__Keys__0__Key=replace_with_a_unique_owner_api_key
# ApiAccess__Keys__0__TelegramUserId=123456789
# ApiAccess__Keys__1__Key=replace_with_a_unique_employee_api_key
# ApiAccess__Keys__1__TelegramUserId=234567890
# ApiAccess__Keys__2__Key=replace_with_a_unique_client_api_key
# ApiAccess__Keys__2__TelegramUserId=345678901

Booking__SlotStepMinutes=15
Booking__MaxAdvanceDays=30
