# Copy to .env in this directory. Never commit .env.
# Development credentials only. Replace both copies of the example password.
# Use a password without semicolons for this simple connection-string example.
POSTGRES_DB=appointmentbooking
POSTGRES_USER=appointment_app
POSTGRES_PASSWORD=van40k
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=appointmentbooking;Username=appointment_app;Password=van40k"

# Reserved for the Telegram and identity tasks; disabled in the foundation.
Telegram__Enabled=false
Telegram__Mode=Polling
Telegram__BotToken=
Telegram__WebhookUrl=
Telegram__WebhookSecret=
Owner__TelegramUserId=0
